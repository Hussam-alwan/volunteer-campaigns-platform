# Dev mode uses the Vite proxy (see vite.config.ts) so all requests stay
# same-origin in the browser.
VITE_API_BASE_URL=/api-railway/api/v1

# Which backend the Vite proxy forwards to. Default is http://localhost:8080/
# (local Spring backend, see LOCAL_BACKEND.md). Uncomment the next line to
# point the dev frontend at the deployed Railway backend instead.
# VITE_DEV_BACKEND_URL=https://sbc-production.up.railway.app/
